---
import { type ChallengeStats, formatAmount, formatDay } from '../lib/challenges';

interface Props {
  stats: ChallengeStats;
  unit: string;
  schedule: 'daily' | 'weekly' | 'flexible';
  /** Last day that belongs to the challenge (planned finish or deadline); later days are dimmed. */
  until?: string;
}
const { stats, unit, schedule, until } = Astro.props;
const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const maxAmount = Math.max(1, ...[...stats.days.values()].map((d) => d.amount));

/** Flexible challenges shade a day by how much was done, in four steps; daily and weekly days are simply done. */
const level = (amount: number) => (schedule !== 'flexible' ? 4 : Math.max(1, Math.ceil((amount / maxAmount) * 4)));
---

<div class="challenge-calendar" data-challenge-calendar data-schedule={schedule}>
  <ul class="cal-legend" aria-label="Legend">
    <li><span class="cal-swatch done"></span> Done</li>
    {schedule === 'daily' && <li><span class="cal-swatch missed"></span> Missed</li>}
    <li><span class="cal-swatch today"></span> Today</li>
    {stats.finish && !stats.complete && <li><span class="cal-swatch finish"></span> {schedule === 'daily' ? 'Planned finish' : 'Deadline'}</li>}
  </ul>
  <div class="cal-months">
    {
      stats.months.map((month) => (
        <section class="cal-month">
          <h3>{month.label}</h3>
          <table>
            <thead>
              <tr>
                {weekdays.map((d) => (
                  <th scope="col" abbr={d}>
                    {d.slice(0, 1)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {month.weeks.map((week) => (
                <tr>
                  {week.map((day) => {
                    if (!day) return <td />;
                    const logged = stats.days.get(day);
                    const inRange = day >= stats.start && (!until || day <= until);
                    const label = `${formatDay(day)}${logged ? `: ${formatAmount(logged.amount, unit)}` : ''}${logged?.notes.length ? `. ${logged.notes.join(' ')}` : ''}`;
                    return (
                      <td
                        data-day={day}
                        data-in-range={inRange ? '' : undefined}
                        data-logged={logged ? '' : undefined}
                        class:list={[
                          logged ? `done l${level(logged.amount)}` : !inRange && 'out',
                          { finish: day === stats.finish && !stats.complete, start: day === stats.start },
                        ]}
                        title={label}
                      >
                        <span aria-hidden="true">{Number(day.slice(8))}</span>
                        <span class="sr-only">{label}</span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    }
  </div>
</div>

<script>
  /** Today and missed days depend on the visitor's date, not the build date, so they are marked here. */
  function markCalendar() {
    const now = new Date();
    const local = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const today = local(now);
    const yesterday = local(new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1));

    for (const cal of document.querySelectorAll<HTMLElement>('[data-challenge-calendar]')) {
      const daily = cal.dataset.schedule === 'daily';
      let missed = 0;
      for (const cell of cal.querySelectorAll<HTMLElement>('td[data-day]')) {
        const day = cell.dataset.day!;
        cell.classList.toggle('today', day === today);
        if (day === today) cell.setAttribute('aria-current', 'date');
        const isMissed = daily && day < today && cell.dataset.inRange !== undefined && cell.dataset.logged === undefined;
        cell.classList.toggle('missed', isMissed);
        if (isMissed) missed++;
      }
      cal.dataset.missed = String(missed);
    }

    // A daily streak is broken once a whole day has passed without an entry.
    for (const el of document.querySelectorAll<HTMLElement>('[data-streak-last]')) {
      if (el.dataset.streakLast! < yesterday) el.textContent = el.dataset.streakBroken ?? '0';
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-missed-count]')) {
      const cal = document.querySelector<HTMLElement>('[data-challenge-calendar]');
      const n = Number(cal?.dataset.missed ?? 0);
      el.textContent = `${n} ${n === 1 ? 'day' : 'days'}`;
      el.closest<HTMLElement>('[data-missed-row]')?.toggleAttribute('hidden', n === 0);
    }
  }

  document.addEventListener('astro:page-load', markCalendar);
</script>
