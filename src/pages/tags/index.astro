---
import Base from '../../layouts/Base.astro';
import { collectTags, getPosts } from '../../lib/content';

const tags = collectTags(await getPosts()).sort((a, b) => a.name.localeCompare(b.name));
---

<Base title="Tags" description="All tags used on notes.">
  <header class="page-head">
    <h1>Tags</h1>
    <p>{tags.length} tags, A to Z.</p>
  </header>
  <ul class="chips">
    {
      tags.map((t) => (
        <li>
          <a class="chip tag" href={`/tags/${t.slug}/`}>
            {t.name} <span class="count">{t.posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
