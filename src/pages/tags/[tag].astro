---
import PlayActions from '../../components/PlayActions.astro';
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import { collectTags, getPosts, type Post, postToItem } from '../../lib/content';

export async function getStaticPaths() {
  return collectTags(await getPosts()).map((t) => ({ params: { tag: t.slug }, props: { name: t.name, posts: t.posts } }));
}

interface Props {
  name: string;
  posts: Post[];
}
const { name, posts } = Astro.props;
---

<Base title={`#${name}`} description={`Notes tagged ${name}.`}>
  <header class="page-head">
    <p class="eyebrow"><a href="/tags/">Tags</a></p>
    <h1>#{name}</h1>
    <p>{posts.length} {posts.length === 1 ? 'note' : 'notes'}</p>
    <PlayActions items={posts.map(postToItem)} label="Listen to all" />
  </header>
  <ul class="card-list">
    {posts.map((post) => <li><PostCard post={post} /></li>)}
  </ul>
</Base>
